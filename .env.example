NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required in production — shared admin password + session HMAC secret (no defaults).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=
# Canonical site URL for SEO (sitemap, Open Graph) and OAuth redirect allowlist.
NEXT_PUBLIC_SITE_URL=https://letsrace.cz
# Free Carto Voyager key: https://carto.com/basemaps/apikey/ (no Carto account).
# Public by design — it is embedded in tile URLs. Fair use 5M tiles/month.
NEXT_PUBLIC_CARTO_API_KEY=
# Optional Slack/generic webhook for ingest failure alerts
INGEST_ALERT_WEBHOOK_URL=
# Email: nearby-race alerts, plan-change notices and the Wednesday digest go out
# through Resend. Without the key and sender nothing is emailed (matches still
# land on Discover). See docs/emails.md for the whole setup.
RESEND_API_KEY=
# A verified sender on your own domain, e.g. Let's Race <zavody@letsrace.cz>
RESEND_FROM=
# Optional: where replies go, e.g. ahoj@letsrace.cz
RESEND_REPLY_TO=
# Signs unsubscribe links (any long random string; falls back to CRON_SECRET).
EMAIL_LINK_SECRET=
# Search console ownership. Paste the token from each tool's HTML-tag method.
# Google:  verified by DNS TXT on the Domain property — set this only if you
#          switch to a URL-prefix property and want the meta tag instead
# Seznam:  https://search.seznam.cz/wmt              (seznam-wmt) — ~10% of Czech search
# Bing:    https://www.bing.com/webmasters           (msvalidate.01) — also feeds Copilot
GOOGLE_SITE_VERIFICATION=
SEZNAM_WMT_VERIFICATION=
BING_SITE_VERIFICATION=

# Umami: real public website UUID, production only. Preview testing uses its own ID.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_TEST_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_TEST_ENABLED=false
