{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "publication": {
      "schedule": "40 5 * * *",
      "path": "/api/cron/publication",
      "requestMethod": "GET"
    },
    "catalog": {
      "schedule": "15 5 * * *",
      "path": "/api/cron/catalog",
      "requestMethod": "GET"
    },
    "public-refresh": {
      "schedule": "30 5 * * *",
      "path": "/api/cron/public-refresh",
      "requestMethod": "GET"
    },
    "alerts": {
      "schedule": "45 5 * * *",
      "path": "/api/cron/alerts",
      "requestMethod": "GET"
    },
    "digest": {
      "schedule": "0 4 * * 3",
      "path": "/api/cron/digest",
      "requestMethod": "GET"
    },
    "weather-history": {
      "schedule": "10 4 * * *",
      "path": "/api/cron/weather-history",
      "requestMethod": "GET"
    }
  },
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in *\"[no deploy]\"*) exit 0;; *) exit 1;; esac"
}
