let cookie='';async function admin(method:string,body:any){if(!cookie){const r=await fetch('https://letsrace.cz/api/admin/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({password:process.env.ADMIN_PASSWORD})});if(!r.ok)throw Error('Authentication failed');cookie=r.headers.get('set-cookie')!.split(';')[0];}const r=await fetch('https://letsrace.cz/api/admin/events',{method,headers:{'content-type':'application/json',cookie},body:JSON.stringify(body)});if(!r.ok)throw Error(await r.text());return r.json();}
async function get(id:string):Promise<any>{const {data,error}=await db.from('events').select('*,location:locations(*),categories:event_categories(*),sources:event_sources(*),overrides:event_overrides(*)').eq('id',id).single();if(error)throw error;return data;}
const results:any[]=JSON.parse(await readFile(root+'/results.json','utf8'));const manifest:any[]=JSON.parse(await readFile(root+'/manifest.json','utf8'));
async function patch(key:string,id:string,fields:any,source:string,quote:string,notes:string){
 const before=await get(id);const previous:any={};for(const k of Object.keys(fields))previous[k]=before[k];
 const {error}=await db.from('events').update({...fields,updated_at:new Date().toISOString()}).eq('id',id);if(error)throw error;
 const old=before.overrides;const {error:oe}=await db.from('event_overrides').upsert({event_id:id,fields:{...(old?.fields??{}),...fields},locked_fields:[...new Set([...(old?.locked_fields??[]),...Object.keys(fields)])],updated_by:old?.updated_by??'admin',updated_at:new Date().toISOString()},{onConflict:'event_id'});if(oe)throw oe;
 await recordFacts(db,id,[...Object.entries(fields).filter(([k,v])=>JSON.stringify(before[k])!==JSON.stringify(v)).map(([field,value])=>({field,value,previous:previous[field],sourceUrl:source,quote})),{field:'source_evidence',value:{notes,source,review:'independent_primary_source',audit:'cz-2027-2026-10-29'},previous:null,sourceUrl:source,quote}],{method:'manual_verified_official',version:'cz-2027-2026-10-29'});
 const after=await get(id);let row=results.find(x=>x.key===key);if(row)row.after=after;else{row={key,id,action:fields.status==='tbc'?'provisional':fields.visibility==='hidden'?'excluded':'update',before,after,complete:true};results.push(row);}await writeFile(root+'/results.json',JSON.stringify(results,null,2));console.log('REPAIRED',key,id);return after;
}
