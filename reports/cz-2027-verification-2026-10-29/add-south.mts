import {readFile,writeFile} from 'node:fs/promises';import {parse} from 'dotenv';import {createServerSupabase} from '../../src/lib/supabase/server';import {recordFacts} from '../../src/lib/catalog/facts';
Object.assign(process.env,parse(await readFile('.env.local','utf8')));const db=createServerSupabase(),root='reports/cz-2027-verification-2026-10-29';
const {data:existing,error}=await db.from('events').select('id,name,start_date,visibility').gte('start_date','2027-01-01').lt('start_date','2028-01-01').or('name.ilike.%jižních%čech%,name.ilike.%south%bohemia%');if(error)throw error;if(existing?.length)throw Error('Already represented; review existing identity '+JSON.stringify(existing));
const source='https://www.uci.org/competition-details/2027/ROA/81153';const quote='Okolo jižních Čech / Tour of South Bohemia | 09 Sep - 12 Sep 2027 | 2.2 - Stages - Class 2 | INDIVIDUAL ROAD RACE MEN ELITE';
const input={name:'Okolo jižních Čech / Tour of South Bohemia',startDate:'2027-09-09',endDate:'2027-09-12',placeName:'Jižní Čechy — místa etap zatím nezveřejněna',countryCode:'CZ',disciplines:['road_race'],audience:'adults',websiteUrl:'https://www.okolojiznichcech.cz/',status:'scheduled',visibility:'public',lockFields:true};
const login=await fetch('https://letsrace.cz/api/admin/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({password:process.env.ADMIN_PASSWORD})});if(!login.ok)throw Error('Admin login failed');const cookie=login.headers.get('set-cookie')!.split(';')[0];
const response=await fetch('https://letsrace.cz/api/admin/events',{method:'POST',headers:{'content-type':'application/json',cookie},body:JSON.stringify(input)});if(!response.ok)throw Error(await response.text());const {id}=await response.json();await writeFile(root+'/south-created.json',JSON.stringify({id,input,source,quote},null,2));
const {data:before,error:be}=await db.from('events').select('*,location:locations(*),sources:event_sources(*),categories:event_categories(*),overrides:event_overrides(*)').eq('id',id).single();if(be)throw be;
const fields={uci_class:'2.2',class_label:'UCI 2.2',level:'international',age_categories:['elite'],age_confidence:'explicit',formats:['road_race'],timezone:'Europe/Prague'};const {error:ue}=await db.from('events').update(fields).eq('id',id);if(ue)throw ue;
const {error:le}=await db.from('locations').update({region:'Jihočeský kraj',municipality:null,geocode_status:'pending'}).eq('id',before.location_id!);if(le)throw le;
const {error:we}=await db.from('watched_urls').upsert({url:source,kind:'federation',status:'paused',added_by:'pipeline_review',notes:'Individually reviewed UCI2027 calendar evidence. Stage venues unpublished; organizer homepage remains2026.'},{onConflict:'url',ignoreDuplicates:true});if(we)throw we;
const {data:w,error:wr}=await db.from('watched_urls').select('id').eq('url',source).single();if(wr)throw wr;
const {error:se}=await db.from('event_sources').upsert({event_id:id,watched_url_id:w.id,source_url:source,external_id:'uci-ROA-81153-2027',kind:'official',is_canonical:true},{onConflict:'watched_url_id,external_id'});if(se)throw se;
const notes='Additional independently discovered missing2027 edition confirmed by live UCI. Organizer homepage still2026, no old stages, entry links or host towns copied. Exact2027 stage venues not yet published: regional location only, coordinates deliberately null, geocoding pending, no invented map pin. UCI address sídliště Pod kasárny may be organizer address and is not assumed to be a start.';
await recordFacts(db,id,[{field:'source_evidence',value:{source,quote,input,classification:fields,notes,geocoding:'unpublished_stage_venues_no_map_pin'},previous:null,sourceUrl:source,quote}],{method:'manual_verified_official',version:'cz-2027-2026-10-29'});
const {data:after,error:ae}=await db.from('events').select('*,location:locations(*),sources:event_sources(*),categories:event_categories(*),overrides:event_overrides(*)').eq('id',id).single();if(ae)throw ae;
const results=JSON.parse(await readFile(root+'/results.json','utf8'));results.push({key:'south',id,action:'create',created:true,before:null,after,complete:true});await writeFile(root+'/results.json',JSON.stringify(results,null,2));
const manifest=JSON.parse(await readFile(root+'/manifest.json','utf8'));manifest.push({key:'south',name:input.name,start:input.startDate,end:input.endDate,city:'',region:'Jihočeský kraj',country:'CZ',disc:input.disciplines,source,expectedId:id,action:'create',registrationStatus:'not_published_2027',notes,quote});await writeFile(root+'/manifest.json',JSON.stringify(manifest,null,2));console.log('CREATED',id);
