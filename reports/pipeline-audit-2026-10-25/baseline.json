    "query": "with b as(select e.*,l.country_code,l.municipality,l.lat,l.lng,case when e.start_date<'2027-01-01' then '2026-end' else '2027' end as period from events e left join locations l on l.id=e.location_id where e.visibility='public' and e.merged_into_id is null and e.status in ('scheduled','postponed','registration_open') and e.start_date between '2026-10-25' and '2027-12-31') select period,case when grouping(country_code)=1 then 'ALL' else coalesce(country_code,'UNKNOWN') end country,count(*) total,count(*) filter(where nullif(website_url,'') is not null) website,count(*) filter(where nullif(registration_url,'') is not null) registration,count(*) filter(where coalesce(cardinality(disciplines),0)=0) missing_discipline,count(*) filter(where location_id is null or nullif(municipality,'') is null) missing_place,count(*) filter(where lat is null or lng is null) missing_coordinates,count(*) filter(where age_confidence='explicit' and cardinality(age_categories)>0) explicit_audience from b group by period,rollup(country_code) order by period,total desc",
